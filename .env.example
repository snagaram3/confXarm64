# Host-side API (npm run dev) talks to the published loopback port.
# Docker Compose publishes ${ES_HOST_PORT:-19200}:9200 on the host.
# Inside Compose, the app service must keep ELASTICSEARCH_URL=http://elasticsearch:9200
# (container DNS, in-container port 9200). Do not point the app container at :19200.
ES_HOST_PORT=19200
ELASTICSEARCH_URL=http://127.0.0.1:19200
ELASTICSEARCH_INDEX=floorwise

# Opt-in exhibitor leads (SQLite). Never the public Elasticsearch catalog.
# FLOORWISE_DATA_DIR=/absolute/path/to/data
# Local Web Push (private key lives in gitignored data/vapid.json)
# VAPID_SUBJECT=mailto:floorwise-local@example.com

# Optional Dash0 / any OTLP collector. Leave unset for local-only.
# Ingest (exporter). Dash0 example: https://ingress.<region>.aws.dash0.com
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=confxarm64-api
OTEL_CONSOLE=0

# Optional Dash0 Query API (POST /api/spans). Regional API host only — not ingest.
# DASH0_API_BASE_URL=https://api.us-west-2.aws.dash0.com
# DASH0_AUTH_TOKEN=
# DASH0_DATASET=default
# DASH0_DASHBOARD_URL=https://app.dash0.com
# Operator gRPC ingest (Helm, not this process): ingress.<region>.aws.dash0.com:4317

# Opt-in aggregate synthetic gauges (no names/emails). Off by default.
# FLOORWISE_SYNTHETIC_OTEL=1

# Optional SonarQube / SonarQube Cloud (server-side token, never VITE_*).
# SONAR_HOST_URL=https://sonarcloud.io
# SONAR_TOKEN=
# SONAR_PROJECT_KEY=floorwise
# SONAR_ORGANIZATION=
# Local scan (never uploads without the token above): ./infra/sonar-scan.sh

# Optional Skyhook Radar Kubernetes UI (Tools → Radar). Not api.radar.io and not the live app URL.
# RADAR_UI_URL=

# Optional Elastic Cloud Serverless (Jina embeddings + rerank + Workflows). Public URLs only here.
# API key lives in gitignored .env or Kubernetes Secret confxarm64-secrets — never commit it.
# In-cluster ranking stays on ELASTICSEARCH_URL (floorwise). Cloud is a separate path.
# ELASTIC_CLOUD_ELASTICSEARCH_URL=https://confxarm64-f141cd.es.us-central1.gcp.elastic.cloud
# ELASTIC_CLOUD_INGEST_URL=https://confxarm64-f141cd.ingest.us-central1.gcp.elastic.cloud
# ELASTIC_CLOUD_KIBANA_URL=https://confxarm64-f141cd.kb.us-central1.gcp.elastic.cloud
# ELASTIC_CLOUD_MCP_URL=https://confxarm64-f141cd.kb.us-central1.gcp.elastic.cloud/api/agent_builder/mcp
# ELASTIC_CLOUD_PROJECT_ALIAS=confxarm64-f141cd
# ELASTIC_CLOUD_EMBEDDINGS_INFERENCE_ID=confxarm64-jina-embeddings
# ELASTIC_CLOUD_RERANK_INFERENCE_ID=confxarm64-jina-rerank
# ELASTIC_CLOUD_DEMO_INDEX=confxarm64-jina-demo
# ELASTIC_CLOUD_API_KEY=
