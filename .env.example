# Host-side API (npm run dev) talks to the published loopback port.
# Docker Compose publishes ${ES_HOST_PORT:-19200}:9200 on the host.
# Inside Compose, the app service must keep ELASTICSEARCH_URL=http://elasticsearch:9200
# (container DNS, in-container port 9200). Do not point the app container at :19200.
ES_HOST_PORT=19200
ELASTICSEARCH_URL=http://127.0.0.1:19200
ELASTICSEARCH_INDEX=floorwise

# Opt-in exhibitor leads (SQLite). Never the public Elasticsearch catalog.
# FLOORWISE_DATA_DIR=/absolute/path/to/data
# Local Web Push (private key lives in gitignored data/vapid.json)
# VAPID_SUBJECT=mailto:floorwise-local@example.com

# Optional Dash0 / any OTLP collector. Leave unset for local-only.
# Ingest (exporter). Dash0 example: https://ingress.<region>.aws.dash0.com
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=floorwise-api
OTEL_CONSOLE=0

# Optional Dash0 Query API (POST /api/spans). Regional API host only — not ingest.
# DASH0_API_BASE_URL=https://api.us-west-2.aws.dash0.com
# DASH0_AUTH_TOKEN=
# DASH0_DATASET=default

# Opt-in aggregate synthetic gauges (no names/emails). Off by default.
# FLOORWISE_SYNTHETIC_OTEL=1

# Optional SonarQube / SonarQube Cloud (server-side token, never VITE_*).
# SONAR_HOST_URL=https://sonarcloud.io
# SONAR_TOKEN=
# SONAR_PROJECT_KEY=floorwise
# SONAR_ORGANIZATION=

# Optional Radar. Secret stays on the server. Publishable class is prj_*_pk_ only.
# RADAR_SECRET_KEY=
# RADAR_PUBLISHABLE_KEY=
