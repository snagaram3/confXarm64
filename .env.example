# Elasticsearch (docker compose up)
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=floorwise

# Optional Dash0 / any OTLP collector. Leave unset for local-only.
# Dash0 example: https://ingress.<region>.aws.dash0.com
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=floorwise-api
OTEL_CONSOLE=0
